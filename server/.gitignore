# Environment variables — NEVER commit these
.env
.env.local
.env.*.local

# Node dependencies — these get installed by `npm install` from package.json
node_modules/

# Backtest data cache — fetched from Twelve Data on first run (harness/data.js);
# large, regenerable, and per-machine. Never commit market data.
harness/cache/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor noise
.DS_Store
.vscode/
.idea/
*.swp
