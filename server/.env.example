# Copy this file to `.env` and fill in your real values.
# The `.env` file is gitignored and never gets committed.

# Get a free key from https://finnhub.io (sign up, copy from dashboard)
FINNHUB_API_KEY=your_finnhub_key_here

# Optional. Render sets this automatically in production.
# Locally, leave it unset and the server will use 3000.
# PORT=3000
